  m_Name: 
  m_EditorClassIdentifier: Blink.Runtime::Blink.Interaction.Readable
  verb: Read
  title: Delivery docket
  body: 'RAVEN & SONS COURIERS

    Consignment 0447


    Collect: estate of S. Kerr, Lot 14

    Deliver to: Hale House, end of Blackwood Lane. No road past the gate.

    Contents: 1 x pocket watch, brass. Still ticking.


    Signature on receipt: ______________


    Driver''s note: before midnight. The van clock stopped at the gate. Didn''t ask why.'
  image: {fileID: 0}
  maxDistance: 3
  raiseSeconds: 0.3
  liftSeconds: 0.45
  paperSeed: 0
