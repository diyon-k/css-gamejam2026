  m_Script: {fileID: 11500000, guid: 53a98f48245f3ed4e8b3644b259c4923, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Blink.Runtime::Blink.Interaction.Readable
  verb: Read
  title: Folded note
  body: "If you're reading this, you're awake. Stay that way.\n\nTime doesn't run properly in this house. It holds still while you watch it, and the moment you look away it hurries on without you.\n\nSo don't close your eyes. Not for long. Every blink, the house gets a little further ahead of you, and the things in it get a little closer.\n\nThe key opens the door. I locked it to keep them out, not to keep you in.\n\nFind a way out. Don't wait for morning. It doesn't come here.\n\n\u2014 A."
  image: {fileID: 0}
  maxDistance: 3
  raiseSeconds: 0.3
  liftSeconds: 0.45
  paperSeed: 0
