  m_Script: {fileID: 11500000, guid: 53a98f48245f3ed4e8b3644b259c4923, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Blink.Runtime::Blink.Interaction.Readable
  verb: Read
  title: Kitchen list
  body: "Flour. Lard. Tea. Candles.\n\nThe kettle's been on all morning and won't boil. Mr Hale says a watched pot never does.\nThe mains are seized again. Left loosens, right binds, and rust gives nothing to a hurry.\n\nI've stopped asking the date.\n\u2014 Mrs Pell"
  image: {fileID: 0}
  maxDistance: 3
  raiseSeconds: 0.3
  liftSeconds: 0.45
  paperSeed: 0
