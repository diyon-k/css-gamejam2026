  m_Name: 
  m_EditorClassIdentifier: Blink.Runtime::Blink.Interaction.Readable
  verb: Read
  title: Torn diary page
  body: "...nine days without sleep. The clocks quarrel. The hall clock struck thirteen.\n\nHe has hung us all in a row and turned our faces to him, so we will always know where he is.\nHe keeps his cabinet for the moon now. The moon is slow, he says, but never while you're watching it.\n\u2014 E."
  image: {fileID: 0}
  maxDistance: 3
  raiseSeconds: 0.3
  liftSeconds: 0.45
  paperSeed: 0
