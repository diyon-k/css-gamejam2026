  m_Script: {fileID: 11500000, guid: 53a98f48245f3ed4e8b3644b259c4923, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Blink.Runtime::Blink.Interaction.Readable
  verb: Read
  title: Workshop scrap
  body: 'The heart is gone. S. took it.

    Without it the hands turn neither way.


    Down here the water only rises while no one minds it. Mind it.

    The gate remembers one moment: ours. Two short of midnight.


    Someone always brings things home.'
  image: {fileID: 0}
  maxDistance: 3
  raiseSeconds: 0.3
  liftSeconds: 0.45
  paperSeed: 0
